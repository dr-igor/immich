{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "es2022",
    "moduleResolution": "bundler",
    "noImplicitOverride": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "types": [
      "vitest/globals"
    ]
  },
  "extends": "./.svelte-kit/tsconfig.json",
  "exclude": [
    "node_modules",
  ],
}
